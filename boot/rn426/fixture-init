#!/bin/sh
# QEMU-only disposable fixture creator. Never included in bootable DOM initramfs.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
/bin/busybox --install -s
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
fail() { echo "FIXTURE_FAILED: $*"; while :; do sleep 3600; done; }
[ "$(cat /sys/class/dmi/id/sys_vendor)" = 'QEMU' ] || [ "$(cat /sys/class/dmi/id/sys_vendor)" = 'Bochs' ] || fail 'QEMU DMI required'
for m in virtio_pci virtio_blk raid1 raid10 raid456 ext4 9p 9pnet_virtio; do modprobe "$m" || fail "$m"; done
mkdir -p /input /target
mount -t 9p -o trans=virtio,version=9p2000.L,ro input /input || fail 'read-only fixture input share'
. /input/fixture.conf
for letter in a b c d e f; do
    [ "$(cat /sys/class/block/vd$letter/serial)" = "TENERIX-FIXTURE-$letter" ] || fail 'unexpected virtual disk identity'
    [ "$(cat /sys/class/block/vd$letter/size)" = 8912896 ] || fail 'unexpected virtual disk size'
done
mdadm --create /dev/md0 --metadata=1.2 --level=1 --raid-devices=6 --assume-clean --run --uuid="$SYSTEM_MD_UUID" /dev/vd[a-f]1 || fail 'system create'
mdadm --create /dev/md1 --metadata=1.2 --level=10 --raid-devices=6 --assume-clean --run --uuid="$SWAP_MD_UUID" /dev/vd[a-f]2 || fail 'swap decoy create'
mdadm --create /dev/md2 --metadata=1.2 --level=5 --raid-devices=6 --assume-clean --run --uuid="$DATA_MD_UUID" /dev/vd[a-f]3 || fail 'data decoy create'
mke2fs -t ext4 -F -U "$ROOT_FS_UUID" -L tenerix-root -E lazy_itable_init=0,lazy_journal_init=0 /dev/md0 || fail 'root mkfs'
mount -t ext4 /dev/md0 /target || fail 'root mount'
tar -xzf /input/rootfs.tar.gz -C /target || fail 'root extraction'
sync
umount /target || fail 'root unmount'
mdadm --detail /dev/md0
mdadm --stop /dev/md2 /dev/md1 /dev/md0 || fail 'fixture stop'
echo FIXTURE_CREATED_CLEAN
poweroff -f
